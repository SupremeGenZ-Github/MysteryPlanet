{
  "name": "mystery-planet",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "An educational geography detective game with interactive maps, daily challenges, progressive clues, a discovery passport and optional Mapillary street imagery. Built with HTML, CSS, JavaScript and Node.js; ready for Render.",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/vendor-mapillary.js && node scripts/validate.js",
    "test": "node --test tests/*.test.mjs",
    "import:geography": "node scripts/import-geonames.js",
    "index:geography": "node scripts/build-indexes.js",
    "audit:geography": "node scripts/audit-database.js",
    "backup": "node scripts/backup-database.js"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "dependencies": {
    "mapillary-js": "4.1.2",
    "pg": "8.23.1",
    "yauzl": "3.2.0"
  },
  "license": "MIT"
}
