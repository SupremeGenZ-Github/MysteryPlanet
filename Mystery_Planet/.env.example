# Render: enter these in Web Service > Environment. Do not upload a real .env.
# REQUIRED on Render. Paste your database's Internal Database URL, not this placeholder.
APP_MODE=postgres
DATABASE_URL=
COOKIE_SECURE=auto
# Public Mapillary application client access token. No client secret or OAuth URL.
MAPILLARY_CLIENT_TOKEN=
# Optional custom-domain URL. Render URL and PORT are detected automatically.
APP_ORIGIN=
# PORT=8000
# Local offline development only: set APP_MODE=local and leave DATABASE_URL blank.
# DATABASE_PATH=var/geography.sqlite
# Optional server-only editorial assistant, not required for gameplay.
OPENAI_API_KEY=
OPENAI_MODEL=
